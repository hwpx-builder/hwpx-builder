+    /**
+     * 원본 참조명의 숫자("BIN0002" → 2)를 실제 할당된 binDataId 로 재매핑하고,
+     * crop 사각형을 한/글이 기대하는 좌표계로 변환한다.
+     * 표 셀 안에 중첩된 그림까지 재귀적으로 방문한다.
+     */
+    private static void remapPictureBinIds(HwpDocument doc) {
+        java.util.Map<Integer, Integer> refToId = new java.util.HashMap<>();
+        java.util.Map<Integer, BinDataItem> byId = new java.util.HashMap<>();
+        for (BinDataItem item : doc.binDataItems) {
+            byId.put(item.binDataId, item);
+            String base = item.relativePath;
+            if (base == null) continue;
+            int slash = base.lastIndexOf('/');
+            if (slash >= 0) base = base.substring(slash + 1);
+            int dot = base.lastIndexOf('.');
+            if (dot >= 0) base = base.substring(0, dot);
+            String num = base.replaceAll("[^0-9]", "");
+            if (!num.isEmpty()) {
+                try {
+                    refToId.putIfAbsent(Integer.parseInt(num), item.binDataId);
+                } catch (NumberFormatException ignored) {}
+            }
+        }
+        if (byId.isEmpty()) return;
+        for (Section sec : doc.sections) {
+            remapInParagraphs(sec.paragraphs, refToId, byId);
+        }
+    }
+
+    private static void remapInParagraphs(java.util.List<kr.n.nframe.hwplib.model.Paragraph> paragraphs,
+                                          java.util.Map<Integer, Integer> refToId,
+                                          java.util.Map<Integer, BinDataItem> byId) {
+        for (kr.n.nframe.hwplib.model.Paragraph para : paragraphs) {
+            for (kr.n.nframe.hwplib.model.Control ctrl : para.controls) {
+                if (ctrl instanceof kr.n.nframe.hwplib.model.CtrlPicture) {
+                    kr.n.nframe.hwplib.model.CtrlPicture pic =
+                            (kr.n.nframe.hwplib.model.CtrlPicture) ctrl;
+                    Integer mapped = refToId.get(pic.binItemId);
+                    if (mapped != null) {
+                        pic.binItemId = mapped;
+                    }
+                    BinDataItem item = byId.get(pic.binItemId);
+                    if (item != null && item.data != null) {
+                        fixPictureCropSpace(pic, item.data);
+                    }
+                } else if (ctrl instanceof kr.n.nframe.hwplib.model.CtrlTable) {
+                    for (kr.n.nframe.hwplib.model.TableCell cell :
+                            ((kr.n.nframe.hwplib.model.CtrlTable) ctrl).cells) {
+                        remapInParagraphs(cell.paragraphs, refToId, byId);
+                    }
+                }
+            }
+        }
+    }
+
+    /**
+     * crop(자르기) 사각형을 한/글 바이너리 좌표계로 변환한다.
+     *
+     * HWPX 의 hp:imgClip 은 hp:imgDim 공간의 좌표지만, HWP 바이너리의
+     * "자르기 한 후 사각형"은 이미지 원본 픽셀 크기(px × 75, 96dpi 기준
+     * HWPUNIT) 공간이다 — 한/글 2010 실측: 1280×783px 그림을 표시 크기와
+     * 무관하게 crop right=96000(=1280×75) 으로 기록한다. HWPX 의 imgDim 이
+     * 표시 크기와 같은 값(둘 다 28346)인 문서를 그대로 옮기면 crop 이
+     * 원본의 좌상단 ~30% 로 해석되어 "사진이 잘려" 보인다.
+     */
+    private static void fixPictureCropSpace(kr.n.nframe.hwplib.model.CtrlPicture pic, byte[] data) {
+        if (!("pic".equals(pic.shapeType) || pic.shapeType == null)) return;
+        int[] px = decodeImagePixelSize(data);
+        if (px == null || px[0] <= 0 || px[1] <= 0) return;
+        int naturalW = px[0] * 75;   // 96dpi: 1px = 7200/96 = 75 HWPUNIT
+        int naturalH = px[1] * 75;
+        int dimW = pic.imgDimWidth, dimH = pic.imgDimHeight;
+        if (dimW > 0 && dimH > 0 && (dimW != naturalW || dimH != naturalH)) {
+            pic.cropLeft   = (int) Math.round((double) pic.cropLeft   * naturalW / dimW);
+            pic.cropRight  = (int) Math.round((double) pic.cropRight  * naturalW / dimW);
+            pic.cropTop    = (int) Math.round((double) pic.cropTop    * naturalH / dimH);
+            pic.cropBottom = (int) Math.round((double) pic.cropBottom * naturalH / dimH);
+        } else if (pic.cropRight == 0 && pic.cropBottom == 0) {
+            pic.cropRight = naturalW;
+            pic.cropBottom = naturalH;
+        }
+        pic.imgDimWidth = naturalW;
+        pic.imgDimHeight = naturalH;
+    }
+
+    /**
+     * PNG / JPEG / GIF / BMP 헤더에서 픽셀 크기를 읽는다. 실패 시 null.
+     */
+    private static int[] decodeImagePixelSize(byte[] d) {
+        if (d.length >= 24 && (d[0] & 0xFF) == 0x89 && d[1] == 'P' && d[2] == 'N' && d[3] == 'G') {
+            int w = ((d[16] & 0xFF) << 24) | ((d[17] & 0xFF) << 16) | ((d[18] & 0xFF) << 8) | (d[19] & 0xFF);
+            int h = ((d[20] & 0xFF) << 24) | ((d[21] & 0xFF) << 16) | ((d[22] & 0xFF) << 8) | (d[23] & 0xFF);
+            return new int[]{w, h};
+        }
+        if (d.length >= 4 && (d[0] & 0xFF) == 0xFF && (d[1] & 0xFF) == 0xD8) { // JPEG
+            int i = 2;
+            while (i + 9 < d.length) {
+                if ((d[i] & 0xFF) != 0xFF) { i++; continue; }
+                int marker = d[i + 1] & 0xFF;
+                if (marker == 0xD8 || (marker >= 0xD0 && marker <= 0xD9)) { i += 2; continue; }
+                int len = ((d[i + 2] & 0xFF) << 8) | (d[i + 3] & 0xFF);
+                // SOF0-SOF15 (DHT/DAC/JPG 마커 제외)
+                if (marker >= 0xC0 && marker <= 0xCF && marker != 0xC4 && marker != 0xC8 && marker != 0xCC) {
+                    int h = ((d[i + 5] & 0xFF) << 8) | (d[i + 6] & 0xFF);
+                    int w = ((d[i + 7] & 0xFF) << 8) | (d[i + 8] & 0xFF);
+                    return new int[]{w, h};
+                }
+                i += 2 + len;
+            }
+            return null;
+        }
+        if (d.length >= 10 && d[0] == 'G' && d[1] == 'I' && d[2] == 'F') {
+            return new int[]{(d[6] & 0xFF) | ((d[7] & 0xFF) << 8),
+                             (d[8] & 0xFF) | ((d[9] & 0xFF) << 8)};
+        }
+        if (d.length >= 26 && d[0] == 'B' && d[1] == 'M') {
+            int w = (d[18] & 0xFF) | ((d[19] & 0xFF) << 8) | ((d[20] & 0xFF) << 16) | ((d[21] & 0xFF) << 24);
+            int h = (d[22] & 0xFF) | ((d[23] & 0xFF) << 8) | ((d[24] & 0xFF) << 16) | ((d[25] & 0xFF) << 24);
+            return new int[]{w, Math.abs(h)};
+        }
+        return null;
+    }
 }
